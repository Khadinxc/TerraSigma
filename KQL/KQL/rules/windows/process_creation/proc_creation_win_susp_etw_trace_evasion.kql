// Title: ETW Trace Evasion Activity
// Author: @neu5ron, Florian Roth (Nextron Systems), Jonhnathan Ribeiro, oscd.community
// Date: 2019-03-22
// Level: high
// Description: Detects command line activity that attempts to tamper with Event Tracing for Windows (ETW) by clearing or disabling
// trace logs or providers. Adversaries may target ETW to blind security tooling and evade detection by removing
// visibility into process activity, network connections, and other telemetry sources.
// Techniques include clearing logs via wevtutil, disabling trace sessions via logman, and removing or modifying
// ETW providers using PowerShell cmdlets such as Remove-EtwTraceProvider and Set-EtwTraceProvider.
// MITRE Tactic: Uncategorized
// Tags: attack.stealth, attack.defense-impairment, attack.t1070, attack.t1685, car.2016-04-002
// Reference: https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_etw_trace_evasion.yml

DeviceProcessEvents
| where ((FolderPath endswith "\\wevtutil.exe" or ProcessVersionInfoOriginalFileName =~ "wevtutil.exe") and (((ProcessCommandLine contains " cl " or ProcessCommandLine contains "clear-log") and (ProcessCommandLine contains "-Trace" or ProcessCommandLine contains "/Trace" or ProcessCommandLine contains "–Trace" or ProcessCommandLine contains "—Trace" or ProcessCommandLine contains "―Trace")) or ((ProcessCommandLine contains " sl " or ProcessCommandLine contains "set-log") and (ProcessCommandLine contains "-e:false" or ProcessCommandLine contains "/e:false" or ProcessCommandLine contains "–e:false" or ProcessCommandLine contains "—e:false" or ProcessCommandLine contains "―e:false")))) or ((FolderPath endswith "\\logman.exe" or ProcessVersionInfoOriginalFileName =~ "Logman.exe") and (ProcessCommandLine contains "update" and ProcessCommandLine contains "trace" and ProcessCommandLine contains "--p" and ProcessCommandLine contains "-ets")) or ((ProcessCommandLine contains "Remove-EtwTraceProvider" or (ProcessCommandLine contains "Set-EtwTraceProvider" and ProcessCommandLine contains "0x11") or (ProcessCommandLine contains "Set-EtwTraceProvider" and ProcessCommandLine contains " 17") or (ProcessCommandLine contains "Set-EtwTraceProvider" and ProcessCommandLine contains "'17'") or (ProcessCommandLine contains "Set-EtwTraceProvider" and ProcessCommandLine contains "\"17\"")) and ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("powershell.exe", "pwsh.dll"))))