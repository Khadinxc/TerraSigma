// Title: Uncommon Child Process Spawned From XBootMgrSleep.EXE
// Author: Diablo Research
// Date: 2026-09-27
// Level: medium
// Description: Detects a process other than XBootMgr.exe spawned by XBootMgrSleep.exe.
// XBootMgrSleep.exe is a Microsoft-signed Windows Performance Toolkit binary that can execute an arbitrary executable after a delay.
// MITRE Tactic: Uncategorized
// Tags: attack.stealth, attack.t1202
// Reference: https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_xbootmgrsleep_uncommon_child_process.yml
// False Positives:
//   - Custom Windows Performance Toolkit automation that intentionally launches another executable through XBootMgrSleep.exe

DeviceProcessEvents
| where InitiatingProcessFolderPath endswith "\\xbootmgrsleep.exe" and (not(FolderPath =~ "C:\\Program Files (x86)\\Windows Kits\\10\\Windows Performance Toolkit\\xbootmgr.exe"))